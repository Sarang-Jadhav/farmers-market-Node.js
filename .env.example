# ==========================================
# Server Configuration
# ==========================================
PORT=3000

# ==========================================
# Database Configuration
# ==========================================
# Local MongoDB connection string or MongoDB Atlas URI
MONGO_URI=mongodb://localhost:27017/farmers_market

# ==========================================
# Session Management
# ==========================================
# Secret key used to sign the session ID cookie (use a long, unpredictable random string)
SESSION_SECRET=your_session_secret_here

# ==========================================
# Razorpay Payment Gateway (Test Mode)
# ==========================================
# Get these credentials from your Razorpay Dashboard (Settings > API Keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
