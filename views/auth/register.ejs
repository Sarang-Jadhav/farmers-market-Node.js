<%- include('../partials/header') %>

<div class="row justify-content-center">
  <div class="col-md-5">
    <div class="card shadow-sm">
      <div class="card-body p-4">
        <h3 class="card-title text-center mb-4">Create Account</h3>
        <form action="/auth/register" method="POST">
          <div class="mb-3">
            <label class="form-label">Full Name</label>
            <input type="text" name="name" class="form-control" placeholder="John Farmer" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Email Address</label>
            <input type="email" name="email" class="form-control" placeholder="you@example.com" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Password</label>
            <input type="password" name="password" class="form-control" minlength="6" placeholder="Min 6 characters" required>
          </div>
          <div class="mb-4">
            <label class="form-label">I am a...</label>
            <div class="d-flex gap-3">
              <div class="form-check flex-fill border rounded p-3 role-card">
                <input class="form-check-input" type="radio" name="role" id="roleFarmer" value="farmer" required>
                <label class="form-check-label w-100" for="roleFarmer">
                  <i class="bi bi-tree fs-4 d-block mb-1 text-success"></i>
                  <strong>Farmer</strong>
                  <small class="d-block text-muted">Sell my produce</small>
                </label>
              </div>
              <div class="form-check flex-fill border rounded p-3 role-card">
                <input class="form-check-input" type="radio" name="role" id="roleCustomer" value="customer" required>
                <label class="form-check-label w-100" for="roleCustomer">
                  <i class="bi bi-person fs-4 d-block mb-1 text-primary"></i>
                  <strong>Customer</strong>
                  <small class="d-block text-muted">Buy fresh produce</small>
                </label>
              </div>
            </div>
          </div>
          <button type="submit" class="btn btn-primary w-100">Register</button>
        </form>
        <p class="text-center mt-3 mb-0 small">Already have an account? <a href="/auth/login">Login</a></p>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>  