<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h3 class="mb-0">All Products</h3>
  <form action="/user/products" method="GET" class="d-flex gap-2">
    <input type="text" name="search" class="form-control form-control-sm" placeholder="Search products..." value="<%= search %>">
    <button type="submit" class="btn btn-sm btn-outline-success">Search</button>
    <% if (search) { %><a href="/user/products" class="btn btn-sm btn-outline-secondary">Clear</a><% } %>
  </form>
</div>

<% if (products.length === 0) { %>
  <div class="text-center py-5">
    <i class="bi bi-basket fs-1 text-muted"></i>
    <p class="mt-2 text-muted">No products found.</p>
  </div>
<% } else { %>
  <div class="row g-3">
    <% products.forEach(p => { %>
      <div class="col-md-4 col-sm-6">
        <div class="card h-100 shadow-sm">
          <img src="/images/<%= p.image %>" class="card-img-top product-img" alt="<%= p.name %>"
               onerror="this.src='/images/default-product.jpg'">
          <div class="card-body">
            <h6 class="card-title"><%= p.name %></h6>
            <p class="text-muted small mb-1">By <strong><%= p.farmerId.name %></strong></p>
            <p class="text-muted small mb-2"><%= p.description || '' %></p>
            <p class="fw-bold text-success mb-0">₹<%= p.pricePerKg %>/kg</p>
            <p class="text-muted small">Stock: <%= p.stock %> kg</p>
          </div>
          <div class="card-footer bg-transparent">
            <form action="/user/cart/add" method="POST" class="d-flex gap-2">
              <input type="hidden" name="productId" value="<%= p._id %>">
              <input type="number" name="quantity" class="form-control form-control-sm"
                     placeholder="kg" min="0.5" step="0.5" value="1" required style="max-width:80px">
              <button type="submit" class="btn btn-success btn-sm flex-grow-1">
                <i class="bi bi-cart-plus me-1"></i>Add
              </button>
            </form>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>

<%- include('../partials/footer') %>