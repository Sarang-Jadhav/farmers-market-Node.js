<%- include('../partials/header') %>

<div class="row justify-content-center">
  <div class="col-md-7">
    <h3 class="mb-4"><%= typeof product !== 'undefined' ? 'Edit Product' : 'Add New Product' %></h3>
    <div class="card shadow-sm">
      <div class="card-body p-4">
        <form action="/farmer/products/<%= typeof product !== 'undefined' ? 'edit/' + product._id : 'add' %>" method="POST" enctype="multipart/form-data">
          <div class="mb-3">
            <label class="form-label">Product Name *</label>
            <input type="text" name="name" class="form-control" value="<%= typeof product !== 'undefined' ? product.name : '' %>" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Price per Kg (₹) *</label>
            <input type="number" name="pricePerKg" class="form-control" step="0.01" min="0" value="<%= typeof product !== 'undefined' ? product.pricePerKg : '' %>" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Available Stock (kg)</label>
            <input type="number" name="stock" class="form-control" min="0" value="<%= typeof product !== 'undefined' ? product.stock : '100' %>">
          </div>
          <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea name="description" class="form-control" rows="3"><%= typeof product !== 'undefined' ? product.description : '' %></textarea>
          </div>
          <div class="mb-4">
            <label class="form-label">Product Image</label>
            <input type="file" name="image" class="form-control" accept="image/*">
            <% if (typeof product !== 'undefined' && product.image) { %>
              <small class="text-muted">Current: <%= product.image %> (leave empty to keep)</small>
            <% } %>
          </div>
          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-success"><i class="bi bi-check-circle me-1"></i><%= typeof product !== 'undefined' ? 'Update' : 'Add Product' %></button>
            <a href="/farmer/products" class="btn btn-outline-secondary">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>