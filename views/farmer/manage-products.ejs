<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h3 class="mb-0">My Products</h3>
  <a href="/farmer/products/add" class="btn btn-success"><i class="bi bi-plus-circle me-1"></i>Add Product</a>
</div>

<% if (products.length === 0) { %>
  <div class="text-center py-5">
    <i class="bi bi-box-seam fs-1 text-muted"></i>
    <p class="mt-2 text-muted">No products yet.</p>
    <a href="/farmer/products/add" class="btn btn-success">Add Your First Product</a>
  </div>
<% } else { %>
  <div class="row g-3">
    <% products.forEach(p => { %>
      <div class="col-md-4">
        <div class="card h-100 shadow-sm">
          <img src="/images/<%= p.image %>" class="card-img-top product-img" alt="<%= p.name %>"
               onerror="this.src='/images/default-product.jpg'">
          <div class="card-body">
            <h5 class="card-title"><%= p.name %></h5>
            <p class="text-muted small"><%= p.description || 'No description.' %></p>
            <div class="d-flex justify-content-between align-items-center">
              <span class="fw-bold text-success">₹<%= p.pricePerKg %>/kg</span>
              <span class="text-muted small">Stock: <%= p.stock %> kg</span>
            </div>
          </div>
          <div class="card-footer bg-transparent d-flex gap-2">
            <a href="/farmer/products/edit/<%= p._id %>" class="btn btn-outline-primary btn-sm w-50">
              <i class="bi bi-pencil me-1"></i>Edit
            </a>
            <form action="/farmer/products/delete/<%= p._id %>" method="POST" class="w-50"
                  onsubmit="return confirm('Delete this product?')">
              <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                <i class="bi bi-trash me-1"></i>Delete
              </button>
            </form>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>

<%- include('../partials/footer') %>