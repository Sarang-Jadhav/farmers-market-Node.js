<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Farmers Market</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<nav class="navbar navbar-expand-lg <%= user && user.role === 'farmer' ? 'navbar-farmer' : 'navbar-customer' %>">
  <div class="container">
    <a class="navbar-brand fw-bold" href="/">
      <i class="bi bi-tree-fill me-2"></i>Farmers Market
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navMenu">
      <ul class="navbar-nav ms-auto align-items-center">
        <% if (user) { %>
          <% if (user.role === 'farmer') { %>
            <li class="nav-item"><a class="nav-link" href="/farmer/dashboard"><i class="bi bi-speedometer2 me-1"></i>Dashboard</a></li>
            <li class="nav-item"><a class="nav-link" href="/farmer/products"><i class="bi bi-box-seam me-1"></i>My Products</a></li>
            <li class="nav-item"><a class="nav-link" href="/farmer/products/add"><i class="bi bi-plus-circle me-1"></i>Add Product</a></li>
            <li class="nav-item"><a class="nav-link" href="/farmer/orders"><i class="bi bi-receipt me-1"></i>Orders</a></li>
          <% } else { %>
            <li class="nav-item"><a class="nav-link" href="/user/dashboard"><i class="bi bi-house me-1"></i>Dashboard</a></li>
            <li class="nav-item"><a class="nav-link" href="/user/products"><i class="bi bi-basket me-1"></i>Products</a></li>
            <li class="nav-item"><a class="nav-link" href="/user/cart"><i class="bi bi-cart3 me-1"></i>Cart</a></li>
            <li class="nav-item"><a class="nav-link" href="/user/orders"><i class="bi bi-bag-check me-1"></i>Orders</a></li>
          <% } %>
          <li class="nav-item ms-2">
            <span class="navbar-text me-2 text-muted small">  <%= user.name.split(' ')[0] %>  </span>
            <a href="/auth/logout" class="btn btn-outline-warning btn-sm"><i class="bi bi-box-arrow-right me-1"></i>Logout</a>
          </li>
        <% } else { %>
          <li class="nav-item"><a class="nav-link" href="/auth/login">Login</a></li>
          <li class="nav-item"><a class="nav-link" href="/auth/register">Register</a></li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>

<div class="container mt-4">
  <% if (success && success.length > 0) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <%= success[0] %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>
  <% if (error && error.length > 0) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <%= error[0] %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>